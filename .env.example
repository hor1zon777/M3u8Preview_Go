# ---------------- 基础运行 ----------------
PORT=3000
NODE_ENV=production
# SQLite 文件路径（相对或绝对；前缀 file: 兼容 Prisma DSN）
DATABASE_URL=file:./data/m3u8preview.db

# 绑定地址：开发默认 0.0.0.0，生产默认 127.0.0.1（走 nginx 反代），可显式覆盖
# BIND_ADDRESS=0.0.0.0

# ---------------- 密钥（生产必须修改，>=32 字符且三者不同）----------------
JWT_SECRET=dev-jwt-secret
JWT_REFRESH_SECRET=dev-jwt-refresh-secret
PROXY_SECRET=dev-proxy-secret

# JWT 密钥轮换：新密钥改 KID 并保留旧密钥用于过渡期解码
JWT_KID=v1
# JWT_KID_PREV=v0
# JWT_SECRET_PREV=<上一代 access 密钥>
# JWT_REFRESH_SECRET_PREV=<上一代 refresh 密钥>

# ---------------- CORS ----------------
# 生产必须显式配置为前端实际地址，禁止使用 *
CORS_ORIGIN=http://localhost:5173

# ---------------- 其它 ----------------
# 是否信任 CDN 回源头（CF-Connecting-IP / True-Client-IP），默认 true
# 未部署 CDN 或未限制回源 IP 时请设为 false，防止伪造
TRUST_CDN=true

# 缩略图生成并发（1-20），默认 5
THUMBNAIL_CONCURRENCY=5

# 外部封面下载并发（1-10），默认 2
POSTER_MIGRATION_CONCURRENCY=2

# 覆盖上传/数据目录（默认是项目根下的 uploads/ 与 data/）
# UPLOADS_DIR=/app/uploads
# DATA_DIR=/data

# ---------------- 登录加密协议 ----------------
# 服务端 ECDH P-256 私钥文件；首次启动自动生成（0600）。
# 必须跨重启保持稳定，否则用户已分发的加密载荷无法解密。
# 默认 <DATA_DIR>/ecdh.pem；Docker 部署请挂载持久卷。
# ECDH_PRIVATE_KEY_PATH=/data/ecdh.pem

# ---------------- Docker / 种子账号（与 M3u8Preview_R 保持一致）----------------
# DOCKER_PORT=80
# ADMIN_SEED_PASSWORD=Admin123
# DEMO_SEED_PASSWORD=Demo1234

# ---------------- 字幕功能（远程 GPU Worker 架构）----------------
# 服务器只做任务池 + VTT 仓库，ASR / 翻译 / 模型 / 默认语言等所有字幕参数
# 都在管理后台配置（admin 面板「插件中心 → 字幕 Worker」）和远程 worker 自身配置中维护，
# 不再走环境变量。
#
# 部署步骤：
#   1) SUBTITLE_ENABLED=true 启用功能
#   2) admin 面板生成 worker token
#   3) 部署 m3u8-preview-worker 桌面端，填入 token 即可
SUBTITLE_ENABLED=false
# 字幕 VTT 输出目录（默认 <UPLOADS_DIR>/subtitles）
# SUBTITLE_DIR=/app/uploads/subtitles
# 远程 worker 心跳超时（分钟，1-120），默认 10。
# 超过后任务被重置回 PENDING 让其它 worker 重试。
SUBTITLE_WORKER_STALE_MINUTES=10
# 全局正在 RUNNING 的字幕任务上限（0=不限）。多 worker 部署且共享 ASR/翻译 API 配额时
# 用于防止把上游 LLM 打垮。Token 维度的并发上限在 admin 面板单独编辑。
SUBTITLE_GLOBAL_MAX_CONCURRENCY=0

# ================= 主备双节点高可用（可选，见 docs/ha-failover.md）=================
# 不配置下面任何一项时，服务以单机模式运行，行为与改造前完全一致。
# 启用方式：docker compose -f docker-compose.yml -f docker-compose.ha.yml up -d
#
# 上线前必须在两台 VPS 各确认一次内核支持 FUSE（唯一 Docker 管不到的前提）：
#   ls -l /dev/fuse

# --- 节点身份（两台机器必须不同）---
# HA_NODE_ID=node-a
# HA_PEER_ID=node-b
# 只有"主"那台设 true。它决定自动回切方向、首次引导先后，
# 以及 Cloudflare 不可达时谁被允许自升主。
# HA_PREFERRED=true
# 人工接管逃生舱：primary / replica，设了就跳过全部仲裁逻辑。排障时用。
# HA_FORCE_ROLE=

# --- 节点间地址 ---
# 对端主机名，需与对端 nginx 证书里的名字一致；由 compose 的 extra_hosts 映射到对端 IP。
# HA_PEER_HOSTNAME=node-b.internal
# HA_SELF_ADVERTISE_URL=https://node-a.internal:20203
# HA_PEER_ADVERTISE_URL=https://node-b.internal:20203
# 对端 App 地址，用于 /api/health 直连探测（故障判定的第二信号）。
# HA_PEER_BASE_URL=https://node-b.internal:20203
# HA_SELF_PUBLIC_IP=203.0.113.10
# HA_PEER_PUBLIC_IP=203.0.113.20
# LITEFS_CHANNEL_PORT=20203

# --- Cloudflare（租约仲裁 + DNS 切换）---
# Token 权限收窄到 Zone -> DNS -> Edit，且只授权这一个 zone。
# CF_API_TOKEN=
# CF_ZONE_ID=
# 用户流量的 A 记录全名（当前 primary 会把它指向自己）
# HA_DNS_RECORD=media.example.com
# 租约与交还请求的 TXT 记录全名（需先在 Cloudflare 手工创建）
# HA_LEASE_RECORD=_ha-lease.example.com
# HA_HANDOFF_RECORD=_ha-handoff.example.com

# 实测 appuser 无法在 /litefs 下写库时设为 1，改由 root 运行 server。
# LITEFS_RUN_AS_ROOT=0

# 手动主/备切换：在管理面板「高可用管理」页操作（POST /api/v1/admin/ha/switch），
# 支持平滑交接与强制切换两种模式；无需改环境变量。
# 相关运行时开关存 system_settings（经 LiteFS 复制，两台一致）：
#   haAutoFailback   自动回切闸门（手动把 preferred 切走时自动置 false）
#   haSetupDismissed 管理面板首次部署引导的"不再提示"标记

# ================= 应用内自更新 / 插件中心（可选） =================
# 关闭管理面板的在线更新（检查与安装均拒绝）。机制见 docs/self-update.md。
# UPDATE_DISABLED=0
# 允许外部插件的 healthUrl 指向内网/保留地址（自托管内网服务健康检查场景）。
# 默认拒绝内网并用 SafeFetch 防 SSRF。manifest 格式见 docs/external-plugin-manifest.md。
# PLUGIN_HEALTH_ALLOW_PRIVATE=0
